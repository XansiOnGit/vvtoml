// vvtoml.vivi

toml_text := ""
toml_pos := 0
toml_err := null

toml_error := () {
    return toml_err
}

toml_at := (i) {
    return i64(toml_text.char_at(i))
}

toml_advance := () {
    toml_pos += 1
}

toml_fail := (msg) {
    if toml_err != null { return null }
    toml_err = "toml: " ~ msg
    return null
}

toml_skip_ws := () {
    while toml_pos < toml_text.len {
        c := toml_at(toml_pos)
        if c == 32 or c == 9 or c == 10 or c == 13 { toml_advance() } else { break }
    }
}

// -- Value Parsers --

toml_parse_string := () {
    toml_advance() // skip open quote
    out := ""
    while toml_pos < toml_text.len {
        c := toml_at(toml_pos)
        if c == 34 { // close quote
            toml_advance()
            return out
        }
        out = out ~ toml_text.char_at(toml_pos)
        toml_advance()
    }
    toml_fail("unterminated string")
    return null
}

toml_parse_number := () {
    start := toml_pos
    is_float := false
    while toml_pos < toml_text.len {
        c := toml_at(toml_pos)
        if (c >= 48 and c <= 57) or c == 45 { // digit or minus
            toml_advance()
        } else if c == 46 { // dot
            is_float = true
            toml_advance()
        } else {
            break
        }
    }
    raw := toml_text.substr(start, toml_pos - start)
    if is_float {
        return f64(raw)
    }
    return i64(raw)
}

toml_parse_bool := () {
    if toml_text.substr(toml_pos, 4) == "true" {
        toml_pos += 4
        return true
    }
    if toml_text.substr(toml_pos, 5) == "false" {
        toml_pos += 5
        return false
    }
    toml_fail("invalid boolean")
    return null
}

toml_parse_value := () {
    toml_skip_ws()
    if toml_pos >= toml_text.len { toml_fail("unexpected end"); return null }
    c := toml_at(toml_pos)
    
    if c == 34 { return toml_parse_string() }
    
    if (c >= 48 and c <= 57) or c == 45 { return toml_parse_number() }
    
    if toml_text.substr(toml_pos, 4) == "true" or toml_text.substr(toml_pos, 5) == "false" {
        return toml_parse_bool()
    }
    
    toml_fail("invalid value")
    return null
}

// -- Main Parser --

toml_parse := (raw_text) {
    toml_err = null
    
    // Explicitly cast to string immediately to satisfy the static checker
    text := string(raw_text)
    toml_text = text
    toml_pos = 0
    
    root := []
    current_section := ""
    
    // Cache the length to avoid calling .len dynamically inside the loop
    n := toml_text.len 
    
    while toml_pos < n {
        toml_skip_ws()
        if toml_pos >= n { break }
        
        c := toml_at(toml_pos)
        
        // Table Header [section]
        if c == 91 {
            toml_advance() // skip [
            toml_skip_ws()
            sec_start := toml_pos
            while toml_pos < n and toml_at(toml_pos) != 93 {
                toml_advance()
            }
            current_section = toml_text.substr(sec_start, toml_pos - sec_start)
            toml_advance() // skip ]
            continue
        }
        
        // Key = Value
        key_start := toml_pos
        while toml_pos < n and toml_at(toml_pos) != 61 { // '='
            toml_advance()
        }
        key := toml_text.substr(key_start, toml_pos - key_start).trim()
        toml_advance() // skip '='
        
        val := toml_parse_value()
        if toml_err != null { return null }
        
        if current_section == "" {
            root[key] = val
        } else {
            if root[current_section] == null {
                root[current_section] = []
            }
            root[current_section][key] = val
        }
    }
    
    return root
}
toml_stringify := (data) {
    out := ""
    for k, v in data {
        if v == string {
            out = out ~ k ~ " = \"" ~ v ~ "\"\n"
        } else if v == i64 or v == f64 or v == bool {
            out = out ~ k ~ " = " ~ string(v) ~ "\n"
        } else if v != null and v.len != null {
            // It's a struct/table
            out = out ~ "\n[" ~ k ~ "]\n"
            for k2, v2 in v {
                if v2 == string {
                    out = out ~ k2 ~ " = \"" ~ v2 ~ "\"\n"
                } else {
                    out = out ~ k2 ~ " = " ~ string(v2) ~ "\n"
                }
            }
        }
    }
    return out
}
