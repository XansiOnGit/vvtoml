// vvtoml.vivi - Simple TOML parser/serializer for Vivi

#import "Strings"

toml_text := ""
toml_pos := 0
toml_err := null

toml_error := () {
    return toml_err
}

toml_at := (i) {
    return i64(toml_text.char_at(i))
}

toml_advance := () {
    toml_pos += 1
}

toml_fail := (msg) {
    if toml_err != null { return null }
    toml_err = "toml: " ~ msg
    return null
}

toml_skip_ws := () {
    while toml_pos < toml_text.len {
        c := toml_at(toml_pos)
        if c == 32 or c == 9 or c == 10 or c == 13 {
            toml_advance()
        } else {
            break
        }
    }
}

toml_parse_string := () {
    toml_advance() // skip open quote
    out := ""
    while toml_pos < toml_text.len {
        c := toml_at(toml_pos)
        if c == 34 { // close quote
            toml_advance()
            return out
        }
        out = out ~ toml_text.char_at(toml_pos)
        toml_advance()
    }
    toml_fail("unterminated string")
    return null
}

toml_parse_number := () {
    start := toml_pos
    is_float := false
    while toml_pos < toml_text.len {
        c := toml_at(toml_pos)
        if (c >= 48 and c <= 57) or c == 45 {
            toml_advance()
        } else if c == 46 {
            is_float = true
            toml_advance()
        } else {
            break
        }
    }
    raw := toml_text.substr(start, toml_pos - start)
    if is_float {
        return f64(raw)
    }
    return i64(raw)
}

toml_parse_bool := () {
    if toml_text.substr(toml_pos, 4) == "true" {
        toml_pos += 4
        return true
    }
    if toml_text.substr(toml_pos, 5) == "false" {
        toml_pos += 5
        return false
    }
    toml_fail("invalid boolean")
    return null
}

toml_parse_value := () {
    toml_skip_ws()
    if toml_pos >= toml_text.len { toml_fail("unexpected end"); return null }
    c := toml_at(toml_pos)
    
    if c == 34 { return toml_parse_string() }
    if (c >= 48 and c <= 57) or c == 45 { return toml_parse_number() }
    if toml_text.substr(toml_pos, 4) == "true" or toml_text.substr(toml_pos, 5) == "false" {
        return toml_parse_bool()
    }
    
    toml_fail("invalid value")
    return null
}

toml_parse := (raw_text) {
    toml_err = null
    toml_text = string(raw_text)
    toml_pos = 0
    
    root := []
    current_section := ""
    n := toml_text.len 
    
    while toml_pos < n {
        toml_skip_ws()
        if toml_pos >= n { break }
        
        c := toml_at(toml_pos)
        
        // Table Header [section]
        if c == 91 {
            toml_advance() // skip [
            toml_skip_ws()
            sec_start := toml_pos
            while toml_pos < n and toml_at(toml_pos) != 93 {
                toml_advance()
            }
            raw_sec := toml_text.substr(sec_start, toml_pos - sec_start)
            current_section = trim(raw_sec)
            toml_advance() // skip ]
            continue
        }
        
        // Key = Value
        key_start := toml_pos
        while toml_pos < n and toml_at(toml_pos) != 61 {
            toml_advance()
        }
        raw_key := toml_text.substr(key_start, toml_pos - key_start)
        key := trim(raw_key)
        
        toml_advance() // skip '='
        
        val := toml_parse_value()
        if toml_err != null { return null }
        
        if current_section == "" {
            root[key] = val
        } else {
            if root[current_section] == null {
                root[current_section] = []
            }
            root[current_section][key] = val
        }
    }
    
    return root
}

toml_stringify := (data) {
    out := ""
    
    // First pass: simple key-values
    for k, v in data {
        if v == string {
            out = out ~ string(k) ~ " = \"" ~ v ~ "\"\n"
        } else if v == i32 || v == i64 || v == f32 || v == f64 || v == bool {
            out = out ~ string(k) ~ " = " ~ string(v) ~ "\n"
        }
    }
    
    // Second pass: tables
    for k, v in data {
        if v != null and v != string and v != i32 and v != i64 and v != f32 and v != f64 and v != bool {
            out = out ~ "\n[" ~ string(k) ~ "]\n"
            for k2, v2 in v {
                if v2 == string {
                    out = out ~ string(k2) ~ " = \"" ~ v2 ~ "\"\n"
                } else {
                    out = out ~ string(k2) ~ " = " ~ string(v2) ~ "\n"
                }
            }
        }
    }
    
    return out
}
